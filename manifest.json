{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "Argus Lens"
  },
  "author": "Karmendra Pandey",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "css": [
        "content.css"
      ],
      "js": [
        "detectors.js",
        "content.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Scan AI prompts for secrets, PII, and prompt injection before you send them \u2014 locally, on ChatGPT, Claude, and Gemini.",
  "homepage_url": "https://github.com/karmendra8386/argus",
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "Argus Lens \u2014 AI Prompt Guard",
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "short_name": "Argus Lens",
  "version": "0.1.2"
}